# Copy to server/.env and fill in. Never commit the real file.

PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
DB=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/weatherx?retryWrites=true&w=majority

# Allowed browser origins, comma separated (the deployed site URL in production)
CLIENT_URL=http://localhost:5173

# Behind a proxy (Render, Heroku, Nginx)? Number of proxy hops to trust. Defaults to 1 in production.
# TRUST_PROXY=1

# Long random string: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me
# A different long random string (same command as above). Required: sign-in fails without it.
JWT_REFRESH_SECRET=change-me-too
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# OpenWeather map overlay (temperature, rain, wind, clouds, pressure tiles). Without it the map
# still works; only the coloured overlay is off. Check it at /api/weather/map/status
OPENWEATHER_API_KEY=

# OPTIONAL: AI briefing and "Ask WeatherX" written by Claude. Without a key the same
# features run on the built-in rule engine, using the same forecast data.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OPTIONAL — email notifications
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM=WeatherX <no-reply@example.com>

# OPTIONAL — SMS / WhatsApp notifications (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=

# OPTIONAL — tuning / self-hosted data providers (defaults are the public endpoints)
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# PHOTON_URL=https://photon.komoot.io
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# UPSTREAM_TIMEOUT_MS=9000
# HTTP_USER_AGENT=WeatherX/2.0 (contact: you@example.com)

# ── Notifications ──────────────────────────────────────────────
# Web Push (browser alerts). Generate once with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Jobs (cron syntax). Defaults: watch every 20 min, daily summary check hourly (sent ~7am local, once a day)
# WEATHER_WATCH_CRON=*/20 * * * *
# DAILY_DIGEST_CRON=10 * * * *
# Email delivery only to verified addresses (there is no verification flow yet, so leave unset)
# EMAIL_REQUIRE_VERIFIED=true
# Old OpenWeather-based alert job (duplicates the new watcher; leave off)
# LEGACY_ALERT_EVALUATION=true
